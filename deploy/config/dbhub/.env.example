# DBHub central env file — TEMPLATE (shareable, no real secrets here).
#
# Each developer copies this file to `.env` (same directory) and fills in
# real values. The `.env` file is read by `docker run --env-file ...` and
# populates the dbhub container's environment, where `${VAR}` placeholders
# in dbhub.toml get resolved.
#
# Convention: prefix per source, e.g. ACME_LOCAL_* for the acme project,
# MYPRJ_LOCAL_* for another project's local dev. Keep these in sync with the
# ${VAR} placeholders in dbhub.toml.

# ─── Acme local dev ─────────────────────────────────────────────────
ACME_LOCAL_DB_HOST=host.docker.internal
ACME_LOCAL_DB_PORT=3342
ACME_LOCAL_DB_NAME=acme
ACME_LOCAL_DB_USER=root
ACME_LOCAL_DB_PASSWORD=root

# ─── Template for additional projects ────────────────────────────────────
# MYPRJ_LOCAL_DB_HOST=host.docker.internal
# MYPRJ_LOCAL_DB_PORT=3306
# MYPRJ_LOCAL_DB_NAME=myproject
# MYPRJ_LOCAL_DB_USER=root
# MYPRJ_LOCAL_DB_PASSWORD=root
